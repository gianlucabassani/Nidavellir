# ============================================
# NIDAVELLIR ENVIRONMENT CONFIGURATION
# ============================================

# === OPERATION MODE ===
# Production Docker-local: MOCK_MODE=false, RANGE_PROVIDER=docker-local
MOCK_MODE=true

# === OPENSTACK CREDENTIALS ===
# Only for an explicitly selected OpenStack provider; not needed by Docker-local.
OS_AUTH_URL=https://your-openstack-server:5000/v3
OS_USERNAME=your_username
OS_PASSWORD=your_password
OS_PROJECT_ID=your_project_id
OS_REGION_NAME=RegionOne
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

# === WORKER CONFIGURATION ===
# Number of max concurrent lab deployments
WORKER_CONCURRENCY=3
WORKER_LOG_LEVEL=INFO

# === LOCAL SOURCE-BUNDLE INTAKE (M4-B2) ===
# Compressed upload, expanded archive, total content-addressed store, and WebUI
# multipart request limits. Defaults: 32 MiB / 128 MiB / 2 GiB / 34 MiB.
# SOURCE_BUNDLE_MAX_UPLOAD_BYTES=33554432
# SOURCE_BUNDLE_MAX_EXPANDED_BYTES=134217728
# SOURCE_BUNDLE_STORE_MAX_BYTES=2147483648
# WEBUI_MAX_UPLOAD_BYTES=35651584

# === RESEARCH EVIDENCE ARTIFACTS (M4-A) ===
# Per-patch, selected-untracked-file, and total store limits.
# EVIDENCE_ARTIFACT_MAX_BYTES=1048576
# EVIDENCE_UNTRACKED_FILE_MAX_BYTES=262144
# EVIDENCE_ARTIFACT_STORE_MAX_BYTES=2147483648

# === SOURCE REVIEW SNAPSHOTS (UI-R4) ===
# Operator-only, not arena-scoped. A snapshot over its cap fails the capture.
# RESEARCH_REPO_HOST_DIR is the host path of the operator-provisioned Git checkout.
# Compose mounts it read-only at /research/repo in the API and the worker.
# RESEARCH_REPO_HOST_DIR=
# RESEARCH_REPO_LABEL names the checkout at RESEARCH_REPO_DIR in new sessions
# (at most 64 printable characters). It is shown, never part of repo_id.
# RESEARCH_REPO_LABEL=
# SOURCE_REVIEW_SNAPSHOT_MAX_BYTES=67108864
# SOURCE_REVIEW_STORE_MAX_BYTES=1073741824
# Seconds after which a capture with no outcome is recorded as failed (worker lost).
# Values below 1920 are raised to 1920; the capture task's hard limit is 1860.
# SOURCE_REVIEW_CAPTURE_LOST_SECONDS=2100
# Seconds a capture may wait for a worker to start it before it is failed.
# SOURCE_REVIEW_CAPTURE_QUEUED_SECONDS=21600

# === DISCLOSURE BUNDLES (NV-14) ===
# Operator-only files under data/disclosure-bundles/. Nothing deletes them.
# DISCLOSURE_BUNDLE_MAX_BYTES=4194304
# DISCLOSURE_BUNDLE_STORE_MAX_BYTES=268435456

# === FOOTHOLD FILE TRANSFER (M4) ===
# TRANSFER_MAX_FILE_BYTES=1048576
# TRANSFER_CHUNK_BYTES=262144

# === HEADLESS BROWSER + XSS EXECUTION VALIDATOR (M4) ===
# Disposable Chromium is attached only to the selected arena network.
# HEADLESS_BROWSER_IMAGE=zenika/alpine-chrome:124
# HEADLESS_BROWSER_TIMEOUT_SECONDS=20
# HEADLESS_BROWSER_MAX_OUTPUT_BYTES=65536
# HEADLESS_BROWSER_MEMORY=512m

# === AUTHENTICATION (ADR-0002) ===
# API key the stack bootstraps and the WebUI uses to call the orchestrator.
# Generate a real one for any reachable deployment:  openssl rand -hex 24
NIDAVELLIR_API_KEY=dev-insecure-key
# WebUI operator login (defaults are demo-only — change both!)
WEBUI_USERNAME=admin
WEBUI_PASSWORD=nidavellir

# === WEB UI SECURITY ===
SECRET_KEY=random-string

# === SECRETS ENCRYPTION AT REST (audit #14) ===
# Fernet key used to encrypt lab outputs (SOC credentials, SSH commands, IPs)
# in the database. Generate one with:  python -m crypto
# Leave unset for the mock/dev demo (outputs stored in plaintext); set it for
# any real deployment.
# SECRETS_ENCRYPTION_KEY=

# === PRODUCTION POSTGRESQL (required by docker-compose.prod.yml) ===
# Enable both profiles: postgres and agent-gateway. Generate a distinct password.
# Use URL-safe hex secrets, or percent-encode the password in DATABASE_URL.
# Scripts read .env via Compose, never execute it. Do not commit .env; chmod 600.
# POSTGRES_PASSWORD=<random-at-least-16-characters>
# DATABASE_URL=postgresql+psycopg://nidavellir:<pw>@postgres:5432/nidavellir
# DATABASE_URL must contain the same password as POSTGRES_PASSWORD.
# Also replace NIDAVELLIR_API_KEY, WEBUI_PASSWORD, SECRET_KEY above and set
# SECRETS_ENCRYPTION_KEY (Fernet); all five must be at least 16 characters.
# Generate Fernet: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# NIDAVELLIR_AGENT_KEY=<separate-role-agent-key-created-through-auth.py>
# Never reuse the admin API key for an in-arena agent.

# === DEBUGGING ===
DEBUG_MODE=false
FLASK_ENV=production

# Redis redelivers an unacknowledged lifecycle task after this many seconds (PF-01 U3).
# Keep it above every task's hard time limit (deploy, destroy, reset, PoC, review).
# CELERY_VISIBILITY_TIMEOUT_SECONDS=7200
