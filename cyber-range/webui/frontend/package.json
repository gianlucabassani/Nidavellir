{
  "name": "nidavellir-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && prettier --check src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
