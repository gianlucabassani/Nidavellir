# --- Secrets and local configuration (never commit) ---
.env
.env.*
.env*
!.env.example
*.pem
*.pub
id_rsa
ssh_keys/
nidavellir_ssh_key*

# --- Terraform / OpenTofu ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/

# --- Dev / test artifacts ---
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Runtime state (generated) ---
/runs/
/data/
/cache/
/keys/
/deployments/
cyber-range/data/
# MCP gateway JSONL traces (compose mounts ./traces on gateway runs)
/traces/

# Built operator console (reproduced from cyber-range/webui/frontend/package-lock.json)
/cyber-range/webui/static/console/

# --- Local agent workspace ---
/AGENT.md
/.agent/
/.lab.yaml

# --- Operator and internal material: kept local, never published ---
# The Guard workflow (scripts/check-public-tree.py) enforces the same list in CI.
/dev/
/ISSUES.md
/CODEX-BRIEF.md
/REVIEW_*.md
/FABLE_*.md
/OSS_CLEANUP_RESULT.md
/OSS_FIX_RESULT.md
*.operator.md
docs/JOURNAL.md
docs/operator-notes/
docs/reviews/
docs/research/
docs/verification/
